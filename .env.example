# ─────────────────────────────────────────────────────────────────────────────
# PixMatch Backend — Environment Variables
# Copy to .env for local dev.  For Render, add each key in Dashboard → Environment.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_HEX_CHARS

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection String (Transaction/Pooler mode)
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Direct connection — used ONLY for migrations (python migrations/migrate.py)
SUPABASE_DIRECT_HOST=db.YOUR_PROJECT_REF.supabase.co
SUPABASE_DIRECT_PORT=5432
SUPABASE_DIRECT_USER=postgres
SUPABASE_DIRECT_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Upstash dashboard → Redis → Connect → .env tab → copy the REDIS_URL line
# Format: rediss://default:PASSWORD@ENDPOINT.upstash.io:6380
REDIS_URL=rediss://default:CHANGE_ME@CHANGE_ME.upstash.io:6380

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_HEX_CHARS
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Cloudinary dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── SendGrid ──────────────────────────────────────────────────────────────────
# SendGrid → Settings → API Keys → Create API Key (full access or restricted to Mail Send)
SENDGRID_API_KEY=SG.CHANGE_ME
FROM_EMAIL=noreply@yourdomain.com

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Your Vercel deployment URL — used for CORS and password-reset email links
FRONTEND_URL=https://YOUR_APP.vercel.app

# ── InsightFace ───────────────────────────────────────────────────────────────
INSIGHTFACE_CTX_ID=-1
MATCH_DISTANCE_THRESHOLD=0.50
